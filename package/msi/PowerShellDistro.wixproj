<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <DefineConstants>ProductSourcePath=$(PayloadDirectory);ProductName=Devolutions PowerShell;ProductVersion=$(MsiProductVersion);SimpleProductVersion=$(SimpleProductVersion);ProductSemanticVersion=$(SemanticVersion);IsPreview=False</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="4.0.6" />
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.6" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
    <HarvestDirectory Include="$(PayloadDirectory)">
      <DirectoryRefId>VersionFolder</DirectoryRefId>
      <ComponentGroupName>ApplicationFiles</ComponentGroupName>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressCom>true</SuppressCom>
      <SuppressRegistry>true</SuppressRegistry>
      <PreprocessorVariable>var.ProductSourcePath</PreprocessorVariable>
    </HarvestDirectory>
  </ItemGroup>
</Project>
