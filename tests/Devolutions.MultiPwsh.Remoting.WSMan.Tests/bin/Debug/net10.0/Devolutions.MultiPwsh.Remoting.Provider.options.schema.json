{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devolutions.net/schemas/multipwsh/remoting/devolutions.wsman.options.schema.json",
  "title": "Devolutions managed WSMan provider options",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpointUri"
  ],
  "properties": {
    "endpointUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "authentication": {
      "type": "string",
      "enum": [
        "Negotiate",
        "Kerberos",
        "Ntlm"
      ],
      "default": "Negotiate"
    },
    "shellUri": {
      "type": "string",
      "minLength": 1,
      "default": "http://schemas.microsoft.com/powershell/Microsoft.PowerShell"
    },
    "minRunspaces": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "maxRunspaces": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "openTimeoutMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "default": 180000
    },
    "operationTimeoutMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "default": 180000
    },
    "maxEnvelopeSizeKilobytes": {
      "type": "integer",
      "minimum": 1,
      "default": 500
    },
    "skipCertificateCheck": {
      "type": "boolean",
      "default": false
    },
    "kdcProxyUri": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "pattern": "^https://"
    },
    "spn": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
