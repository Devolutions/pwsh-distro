{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devolutions.net/schemas/multipwsh/remoting/devolutions.wsman.options.schema.json",
  "title": "Devolutions managed WSMan provider options",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpointUri"
  ],
  "properties": {
    "endpointUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "Absolute WSMan endpoint. Its path component maps directly to DevoWSManConnectionInfo.AppName and is the complete HTTP request path."
    },
    "authentication": {
      "type": "string",
      "enum": [
        "Negotiate",
        "Kerberos",
        "Ntlm"
      ],
      "default": "Negotiate"
    },
    "shellUri": {
      "type": "string",
      "minLength": 1,
      "default": "http://schemas.microsoft.com/powershell/Microsoft.PowerShell"
    },
    "minRunspaces": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "maxRunspaces": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "maxConnections": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "default": 20
    },
    "domain": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256,
      "default": null
    },
    "sspiProvider": {
      "type": "string",
      "enum": [
        "Default",
        "Platform",
        "Rust"
      ],
      "default": "Default",
      "description": "Default selects the platform provider; Platform explicitly selects the operating-system provider; Rust selects SSPI-rs."
    },
    "openTimeoutMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "default": 180000
    },
    "operationTimeoutMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "default": 180000
    },
    "cancelTimeoutMilliseconds": {
      "type": "integer",
      "minimum": 0,
      "default": 60000,
      "description": "Shell cleanup uses max(5000, cancelTimeoutMilliseconds), matching DevoWSManConnectionInfo behavior."
    },
    "maxEnvelopeSizeKilobytes": {
      "type": "integer",
      "minimum": 1,
      "default": 512
    },
    "skipCertificateCheck": {
      "type": "boolean",
      "default": false
    },
    "kdcProxyName": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 2048,
      "default": null,
      "description": "SSPI KDC proxy name, for example host:port:path."
    },
    "spn": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
