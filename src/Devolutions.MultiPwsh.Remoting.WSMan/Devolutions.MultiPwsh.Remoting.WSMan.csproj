<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AdapterTargetFramework Condition="'$(AdapterTargetFramework)' == ''">net8.0</AdapterTargetFramework>
    <TargetFramework>$(AdapterTargetFramework)</TargetFramework>
    <AssemblyName>Devolutions.MultiPwsh.Remoting.WSMan</AssemblyName>
    <RootNamespace>Devolutions.MultiPwsh.Remoting.WSMan</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management.Automation">
      <HintPath>$(PowerShellSdkAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Devolutions.MultiPwsh.Remoting.Provider.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Devolutions.MultiPwsh.Remoting.Provider.options.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateDevolutionsPowerShellSdkReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(PowerShellSdkVendor)' != 'Devolutions'"
           Text="PowerShellSdkVendor must be Devolutions. This adapter must only be compiled against the Devolutions-patched PowerShell SDK." />
    <Error Condition="'$(PowerShellSdkAssemblyPath)' == ''"
           Text="PowerShellSdkAssemblyPath must point to System.Management.Automation.dll from the Devolutions-patched PowerShell SDK." />
    <Error Condition="!Exists('$(PowerShellSdkAssemblyPath)')"
           Text="The Devolutions-patched System.Management.Automation assembly was not found at '$(PowerShellSdkAssemblyPath)'." />
  </Target>
</Project>
